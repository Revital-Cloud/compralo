# =================================================================
# REVITAL PANEL - CONFIGURACIÓN (base)
# =================================================================
# Copia como .env. Luego usa .env.development o .env.production según
# el entorno (ENVIRONMENT=development|production).
# Ver .env.development.example y .env.production.example.

DATABASE_URL=postgresql://usuario:password@localhost:5432/revital_panel
SECRET_KEY=tu_clave_secreta_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7

RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@ejemplo.com
RESEND_FROM_NAME=Revital Panel
FRONTEND_URL=http://localhost:3001
VERIFY_EMAIL_URL=http://localhost:3001/verify-email
RESET_PASSWORD_URL=http://localhost:3001/reset-password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_ENVIRONMENT=sandbox

# Stripe (billing) - opcional, leer con os.getenv si no está en Settings
