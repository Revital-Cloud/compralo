# =================================================================
# REVITAL PANEL - PRODUCCIÓN
# =================================================================
# Copia como .env.production. Se carga cuando ENVIRONMENT=production.

ENVIRONMENT=production

DATABASE_URL=postgresql://usuario:password@host:5432/revital_panel
FRONTEND_URL=https://panel.revital.cloud
VERIFY_EMAIL_URL=https://panel.revital.cloud/verify-email
RESET_PASSWORD_URL=https://panel.revital.cloud/reset-password

RESEND_FROM_EMAIL=noreply@tudominio.com
RESEND_FROM_NAME=Revital Panel

WOMPI_PUBLIC_KEY=pub_prod_xxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxx
WOMPI_EVENTS_SECRET=events_secret_prod
WOMPI_INTEGRITY_SECRET=integrity_secret_prod
WOMPI_ENVIRONMENT=production

