# =============================================================================
# REVITAL ECOMMERCE FRONTEND - DESARROLLO
# =============================================================================
# Copia como .env.development. Next.js lo carga automáticamente con `pnpm dev`
# (NODE_ENV=development).

# API del backend (producción o si desactivas el proxy dev con NEXT_PUBLIC_API_NO_PROXY=1).
# En dev, el navegador suele usar el proxy /api-be de Next (mismo origen que el shop).
#
# Cursor / VS Code "Ports": la columna "Port" es el del SERVIDOR remoto (ej. 8001).
# "Forwarded Address" es el puerto en TU PC (ej. localhost:53696): solo sirve si el
# navegador en tu máquina llama al API directo; con el proxy /api-be no lo necesitas.
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Origen del FastAPI donde corre `next dev` (rewrites /api-be → esta URL). Solo servidor.
# DEV_INTERNAL_API_ORIGIN=http://127.0.0.1:8001

# Wompi sandbox
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxx
