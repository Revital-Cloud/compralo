# =================================================================
# 🛍️ REVITAL ECOMMERCE - DESARROLLO
# =================================================================
# Copia como .env.development. Se carga cuando ENVIRONMENT=development
# (por defecto). Valores típicos para desarrollo local.

ENVIRONMENT=development

# Base de datos local
DATABASE_URL=postgresql://usuario:password@localhost:5432/revital_ecommerce

# URLs del frontend (localhost)
FRONTEND_URL=http://localhost:3000
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Resend: para pruebas usar dominio de Resend
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Dev Store

# Wompi: claves de sandbox/test
WOMPI_PUBLIC_KEY=pub_test_xxxx
WOMPI_PRIVATE_KEY=prv_test_xxxx
WOMPI_EVENTS_SECRET=test_events_xxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxx
WOMPI_ENVIRONMENT=sandbox

# Envia (sandbox): token de prueba; origen coherente con tu bodega/tienda de prueba
ENVIA_TOKEN=
# ENVIA_API_BASE=https://api-test.envia.com
# ENVIA_QUERIES_BASE=https://queries-test.envia.com
# ENVIA_ORIGIN_STREET=Calle 1
# ENVIA_ORIGIN_CITY=Bogotá
# ENVIA_ORIGIN_STATE=DC
# ENVIA_ORIGIN_POSTAL=110111

# Cloudinary: usar cuenta de desarrollo o dejar las que tengas
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Groq: API key para consultas de IA
GROQ_API_KEY=gsk_xxxxx
# Modelos de Groq (opcionales; tienen valores por defecto en el código).
# Útil para cambiar de modelo sin redeploy cuando Groq depreca/renombra uno.
# GROQ_LIGHT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_HEAVY_MODEL=llama-3.3-70b-versatile
# Tope de tokens de salida por respuesta del LLM (control de coste/latencia).
# GROQ_MAX_TOKENS=1024
# Límite de mensajes del chat admin por usuario y minuto (0 = sin límite).
# GROQ_RATE_LIMIT_PER_MIN=20
# Iteraciones máximas del loop de tools del asistente (encadenado de lecturas).
# GROQ_MAX_TOOL_ITERATIONS=3
# Cache en proceso de los datos del dashboard, en segundos (0 = desactivado).
# DASHBOARD_CACHE_TTL_SECONDS=30