[Unit]
Description=Revital Panel API (FastAPI) - port 8080
After=network.target

[Service]
Type=simple
User=revital
Group=revital
WorkingDirectory=/home/revital/revital/revital_panel/backend

ExecStart=/home/revital/revital/revital_panel/backend/venv/bin/fastapi run app/main.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
